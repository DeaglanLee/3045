<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>

<style>
  .error-message {
    color: red;
    margin-top: 5px;
  }
  .disabled-btn {
    background-color: #ccc;
    cursor: not-allowed;
  }
</style>

<body>
  <div class="container">
    <div class="left-section">
      <div class="logo">
        <h1>MindBridge</h1>
        <p><img src="/img/Logo.png" width="275" height="150" alt="MindBridge Logo"></p>
      </div>
    </div>

    <div class="login-box">
      <form action="/registerUser" method="POST">

        <label for="username">Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          placeholder="Enter username" 
          required
        >

        <label for="password">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="Enter password" 
          required
        >

        <div id="passwordError" class="error-message"></div>

        <button class="RegisterLogin" type="submit">Register</button>
      </form>
    </div>
  </div>

<script>
  const passwordInput = document.getElementById("password");
  const errorBox = document.getElementById("passwordError");
  const RegisterLogin = document.getElementById("RegisterLogin")

  function validatePassword() {
    const password = passwordInput.value;
    let erros = [];

    if (password.length < 8) {
      errors.push("Password mus be at least 8 characters long.");
    }
    if (!/[A-Z]/.test(password)){
      errors.push ("Password must contain at least one uppercase letter.");
    }
    if (!/[a-z]/.test(password)){
      errors.push("Password must contain at least one lowercase letter.");
    }
    if(!/[0-9]/.test(password)){
      erors.push("Password must contain at least one number.")
    }

    if (errors.length > 0) {
      errorBox.innerHTML = erros.join("<br>");
      RegisterLogin.disabled = true;
      RegisterLogin.classList.add("disabled-btn");
    }
    else
    {
      errorBox.innerHTML - "";
      RegisterLogin.disabled = false;
      RegisterLogin.classList.remove("disabled-btn");
    }
  }

  passwordInput.addEventListener("Input", validatePassword);
</script>

</body>
</html>