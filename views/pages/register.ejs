<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>

<style>
  .error-message {
    color: red;
    margin-top: 5px;
  }
  .disabled-btn {
    background-color: #ccc;
    cursor: not-allowed;
  }
</style>

<body>
  <div class="container">
    <div class="left-section">
      <div class="logo">
        <h1>MindBridge</h1>
        <p><img src="/img/Logo.png" width="275" height="150" alt="MindBridge Logo"></p>
      </div>
    </div>

    <div class="login-box">
      <form id="form" action="/registerUser" method="POST">

        <label for="username">Email</label>
        <input 
          type="text" 
          id="email" 
          name="email" 
          placeholder="Enter email" 
          required
        >

        <label for="username">Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          placeholder="Enter username" 
          required
        >

        <label for="password">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="Enter password" 
          required
        >

        <div id="passwordError" class="error-message"></div>

        <button class="RegisterLogin" onclick="validateAndSubmit()" type="button">Register</button>
      </form>
    </div>
  </div>

<script>
  const emailInput = document.getElementById("email");
  const usernameInput = document.getElementById("username");
  const passwordInput = document.getElementById("password");
  const errorBox = document.getElementById("passwordError");
  const RegisterLogin = document.getElementById("RegisterLogin")

  function validateAndSubmit() {
    const password = passwordInput.value;
    const username = usernameInput.value;
    const email = emailInput.value;
    let errors = [];

    if (!email.includes("@") || !email.includes(".")) {
      errors.push("Please enter a valid email address.");
    }
    if (username.length < 3) {
      errors.push("Username must be at least 3 characters long.");
    }

    if (password.length < 8) {
      errors.push("Password must be at least 8 characters long.");
    }
    if (!/[A-Z]/.test(password)) {
      errors.push ("Password must contain at least one uppercase letter.");
    }
    if (!/[a-z]/.test(password)) {
      errors.push("Password must contain at least one lowercase letter.");
    }
    if(!/[0-9]/.test(password)) {
      errors.push("Password must contain at least one number.")
    }

    if (errors.length > 0) {
      errorBox.innerHTML = errors.join("<br>");
      RegisterLogin.disabled = true;
      RegisterLogin.classList.add("disabled-btn");
      return;
    }

    document.getElementById("form").submit();
  }
</script>

</body>
</html>